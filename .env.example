SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql://localhost/wikihub
REPOS_DIR=./repos
MAX_WIKIS_PER_USER=500
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ideaflow ID OIDC login (wikihub-39pe). Off unless IDEAFLOW_OIDC_ENABLED=true
# AND both client id/secret are set — see app/routes/auth.py:ideaflow_oidc_enabled.
# Client registration is owned by another team; ask for the confidential
# client id/secret for https://wikihub.md/auth/ideaflow/callback.
IDEAFLOW_OIDC_ENABLED=false
IDEAFLOW_OIDC_ISSUER=https://id.ideaflow.app/api/auth
IDEAFLOW_OIDC_DISCOVERY_URL=https://id.ideaflow.app/api/auth/.well-known/openid-configuration
IDEAFLOW_OIDC_CLIENT_ID=
IDEAFLOW_OIDC_CLIENT_SECRET=
# Automatic sign-in (code-xbh.21.6): with Ideaflow enabled, a signed-out browser
# opening a page makes one silent prompt=none round trip and comes back signed in
# if it has an Ideaflow session. Default on; set false to turn it off (restart).
IDEAFLOW_AUTO_SIGNIN=true

# Ideaflow Ecosystem delegated MCP, disabled until a distinct >=32-character
# per-app secret is set in both WikiHub and the central gateway. Never reuse
# the OIDC client secret, session secret, or a user API key.
IDEAFLOW_CONNECTOR_SECRET=

# Reader assistant (wikihub-1bfx): the public "Ask" panel on reader pages.
# Answers only from pages the visitor can read, with cited links; read-only.
# Shown only when enabled AND READER_ASSISTANT_API_KEY is set (a dedicated,
# budgeted key). The shared ANTHROPIC_API_KEY is used only with
# READER_ASSISTANT_ALLOW_SHARED_KEY=true. Visitors never supply their own key.
READER_ASSISTANT_ENABLED=true
READER_ASSISTANT_API_KEY=
READER_ASSISTANT_MODEL=claude-opus-5-5
READER_ASSISTANT_EFFORT=low
READER_ASSISTANT_MAX_PER_IP_PER_HOUR=20
READER_ASSISTANT_MAX_PER_USER_PER_HOUR=60
READER_ASSISTANT_MAX_PER_DAY=2000
READER_ASSISTANT_MAX_PER_WIKI_PER_DAY=300
READER_ASSISTANT_MAX_CONCURRENT=2
READER_ASSISTANT_ALLOW_SHARED_KEY=false
