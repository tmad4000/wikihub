SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql://localhost/wikihub
REPOS_DIR=./repos
MAX_WIKIS_PER_USER=500
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ideaflow ID OIDC login (wikihub-39pe). Off unless IDEAFLOW_OIDC_ENABLED=true
# AND both client id/secret are set — see app/routes/auth.py:ideaflow_oidc_enabled.
# Client registration is owned by another team; ask for the confidential
# client id/secret for https://wikihub.md/auth/ideaflow/callback.
IDEAFLOW_OIDC_ENABLED=false
IDEAFLOW_OIDC_ISSUER=https://id.ideaflow.app/api/auth
IDEAFLOW_OIDC_CLIENT_ID=
IDEAFLOW_OIDC_CLIENT_SECRET=
